//
// Dialog
//

IDD_ALTALUX_DIALOG DIALOGEX 0, 0, 900, 620
STYLE DS_SETFONT | DS_3DLOOK | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_TRANSPARENT
CAPTION "AltaLux image enhancement filter by Stefano Tommesani"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CTEXT           "Strength",IDC_STRENGTH_STATIC,645,52,190,8,0,WS_EX_TRANSPARENT
    CONTROL         "",IDC_STRENGTH_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_BOTH | TBS_TOOLTIPS | WS_TABSTOP,645,64,190,24,WS_EX_CLIENTEDGE
    CTEXT           "Detail",IDC_DETAIL_STATIC,645,102,190,8,0,WS_EX_TRANSPARENT
    CONTROL         "",IDC_DETAIL_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_BOTH | TBS_TOOLTIPS | WS_TABSTOP,645,114,190,24,WS_EX_CLIENTEDGE
    CTEXT           "Enhances smaller structures",IDC_DETAIL_HELP_STATIC,645,140,190,8,0,WS_EX_TRANSPARENT
    CTEXT           "Natural look",IDC_NATURALLOOK_STATIC,645,152,190,8,0,WS_EX_TRANSPARENT
    CONTROL         "",IDC_NATURALLOOK_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_BOTH | TBS_TOOLTIPS | WS_TABSTOP,645,164,190,24,WS_EX_CLIENTEDGE
    CTEXT           "Smooths tonal transitions",IDC_NATURALLOOK_HELP_STATIC,645,190,190,8,0,WS_EX_TRANSPARENT
    PUSHBUTTON      "Natural",IDC_PRESET_NATURAL,645,214,58,16
    PUSHBUTTON      "Balanced",IDC_PRESET_BALANCED,711,214,58,16
    PUSHBUTTON      "Detail",IDC_PRESET_DETAIL,777,214,58,16
    PUSHBUTTON      "Zoom",IDC_TOGGLEZOOM,711,256,58,16
    DEFPUSHBUTTON   "OK",IDOK,711,594,58,16,0,WS_EX_TRANSPARENT
